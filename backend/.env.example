# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=certiwatch
DB_USER=certiwatch
DB_PASSWORD=certiwatch
DB_HOST=localhost
DB_PORT=5432

# CORS / CSRF (frontend origin)
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Email alerts (HostGator SMTP). Placeholders only: put real values in .env.
#
# SENDER: comes only from these settings (the company mailbox, e.g. a
# GM@ or info@ address on your own domain). RECIPIENTS: come only from the
# Alert Recipients page and can be any domain (Gmail, company addresses...).
#
# 587 + EMAIL_USE_TLS=True is the usual combination; if that fails try
# 465 + EMAIL_USE_SSL=True + EMAIL_USE_TLS=False. TLS and SSL must not both
# be True. Booleans accept true/false, 1/0, yes/no, on/off.
#
# Test with:  python manage.py send_test_email you@gmail.com colleague@company.com --debug
# ---------------------------------------------------------------------------
EMAIL_HOST=your-server.hostgator.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=sender@your-domain.com
EMAIL_HOST_PASSWORD=your-mailbox-password
# Display name + sender address; falls back to EMAIL_HOST_USER if unset.
DEFAULT_FROM_EMAIL=CertiWatch <sender@your-domain.com>
# Seconds to wait for the SMTP server before giving up.
EMAIL_TIMEOUT=20
# Public URL of the frontend, used for the "View certificate" link in alert
# emails. Defaults to FRONTEND_ORIGIN if unset.
FRONTEND_BASE_URL=http://localhost:3000
